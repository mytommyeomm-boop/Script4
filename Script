-- ============================================================
local catchState = {
    running = false, lastThrow = 0, history = {},
    settings = {
        Interval = math.max((Throw.ThrowsPerMinute and 60/Throw.ThrowsPerMinute) or 0.6, 0.25),
        MaxAngle = Control.AssistMaxAngleDegrees or 45,
        MaxRange = Throw.MaxRangeStuds or 200,
        PreferTier = "auto", SkipHeld = true, AutoEnable = true,
    },
}
local function log(m) print("[Suite] "..m) end

local function readBag()
    local c = {}; for _,t in TierOrder do c[t]=0 end
    local s = LocalPlayer:GetAttribute("CatchBalls")
    if type(s)~="string" then return c end
    local i=1
    for n in string.gmatch(s,"[^,]+") do
        if TierOrder[i] then c[TierOrder[i]]=tonumber(n) or 0 end
        i+=1
    end
    return c
end

local function pickTier(c)
    if catchState.settings.PreferTier~="auto" and (c[catchState.settings.PreferTier] or 0)>0 then
        return catchState.settings.PreferTier
    end
    for i=#TierOrder,1,-1 do if (c[TierOrder[i]] or 0)>0 then return TierOrder[i] end end
    return nil
end

local function catchPlayerReady()
    if LocalPlayer:GetAttribute("CatchOn")~=true then
        if catchState.settings.AutoEnable then
            pcall(function() LocalPlayer:SetAttribute("CatchOn",true) end)
        end
        if LocalPlayer:GetAttribute("CatchOn")~=true then return false,"โหมดจับปิด" end
    end
    if LocalPlayer:GetAttribute(CreatureRide.RiderAttribute)==true then return false,"ขี่สัตว์" end
    if LocalPlayer:GetAttribute("IslandVisitState")~=nil then return false,"เยี่ยมเกาะ" end
    local ch=LocalPlayer.Character
    local h=ch and ch:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then return false,"ตาย" end
    if not ch:FindFirstChild("HumanoidRootPart") then return false,"ไม่มี RootPart" end
    return true
end

local function catchable(m)
    if not m:IsA("Model") or not m.PrimaryPart then return false end
    if not m:IsDescendantOf(Workspace) then return false end
    if m:GetAttribute("CatchGhost")==true then return false end
    if m:GetAttribute("RoundHidden")==true then return false end
    if type(m:GetAttribute("SlotId"))~="string" then return false end
    local now=Workspace:GetServerTimeNow()
    if catchState.settings.SkipHeld then
        local h=m:GetAttribute("CatchHeldUntil")
        if type(h)=="number" and now<h then return false end
    end
    local st=m:GetAttribute("BossStunUntil")
    if type(st)=="number" and now<st then return false end
    return true
end

local function findCatchTarget(cam,myPos)
    local camP=cam.CFrame.Position
    local look=cam.CFrame.LookVector
    local best,bs=nil,math.huge
    for _,m in CollectionService:GetTagged(Creatures.CreatureTag) do
        if not catchable(m) then continue end
        local pos=m:GetPivot().Position
        local d=(pos-myPos).Magnitude
        if d>catchState.settings.MaxRange then continue end
        local u=(pos-camP).Unit
        local a=math.deg(math.acos(math.clamp(look:Dot(u),-1,1)))
        if a>catchState.settings.MaxAngle then continue end
        local s=a*1.5+d*0.05
        if s<bs then bs,best=s,m end
    end
    return best
end

local function catchRateOk()
    local now=os.clock()
    if Control.ClientMinGapSeconds and #catchState.history>0
        and now-catchState.history[#catchState.history]<Control.ClientMinGapSeconds then return false end
    while #catchState.history>0 and now-catchState.history[1]>60 do table.remove(catchState.history,1) end
    if Throw.ThrowsPerMinute and #catchState.history>=Throw.ThrowsPerMinute then return false end
    return true
end

local function fireCatch(target,tier)
    if not CatchThrowRemote then return false end
    local ok=pcall(function()
        CatchThrowRemote:FireServer({tier=tier,target=target:GetAttribute("SlotId"),aim=target:GetPivot().Position})
    end)
    if ok then stats.caught+=1; table.insert(catchState.history,os.clock()); return true end
    stats.failed+=1; return false
end

local function catchLoop()
    log("AutoCatch: เริ่ม")
    while catchState.running do
        task.wait(0.05)
        local ready,reason=catchPlayerReady()
        if not ready then stats.lastReason=reason; continue end
        if os.clock()-catchState.lastThrow<catchState.settings.Interval then continue end
        if not catchRateOk() then stats.lastReason="rate limit"; stats.blocked+=1; continue end
        local tier=pickTier(readBag())
        if not tier then stats.lastReason="ไม่มีลูกบอล"; continue end
        local cam=Workspace.CurrentCamera
        local ch=LocalPlayer.Character
        local rt=ch and ch:FindFirstChild("HumanoidRootPart")
        if not cam or not rt then continue end
        local t=findCatchTarget(cam,rt.Position)
        if not t then stats.lastReason="ไม่เจอเป้า"; continue end
        if fireCatch(t,tier) then catchState.lastThrow=os.clock(); stats.lastReason="ยิง" end
    end
    log("AutoCatch: หยุด")
end

