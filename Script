--[[ ============================================================
    AUTO DODGE GUI V2 — FIXED TOGGLE + AUTO RECOVER
    ------------------------------------------------------------
    • Long-press ถูก cancel ถูกต้อง (ไม่ double-toggle)
    • Auto-recover ถ้า GUI หาย
    • Hotkey fallback (F1)
    • Reference HUD ตรง ไม่พึ่ง GetChildren order
    ============================================================ ]]

local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Workspace        = game:GetService("Workspace")

local LP = Players.LocalPlayer

local COLORS = {
    On     = Color3.fromRGB(50, 200, 100),
    Off    = Color3.fromRGB(210, 65, 70),
    Text   = Color3.fromRGB(240, 240, 245),
    TextDim= Color3.fromRGB(150, 155, 170),
    Panel  = Color3.fromRGB(22, 24, 30),
    HUD    = Color3.fromRGB(15, 17, 22),
}

-- ========== สร้าง GUI ใหม่ทั้งหมด ==========
local gui, toggleBtn, panel, hud
local enabledBtn, afBtn, hudBtn, marginLbl
local hudState, hudPid, hudNeeded, hudLand, hudFired
local refresh, setEnabled, openPanel, closePanel

local function buildGUI()
    -- ลบของเก่า
    local old = LP.PlayerGui:FindFirstChild("AutoDodgeUI")
    if old then old:Destroy() end

    gui = Instance.new("ScreenGui")
    gui.Name = "AutoDodgeUI"
    gui.ResetOnSpawn = false        -- ★ ไม่หายตอน respawn
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 9999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = LP:WaitForChild("PlayerGui")

    -- ============ TOGGLE BUTTON ============
    local SIZE = 56
    toggleBtn = Instance.new("TextButton")
    toggleBtn.Name = "ToggleButton"
    toggleBtn.Size = UDim2.fromOffset(SIZE, SIZE)
    toggleBtn.Position = UDim2.new(1, -SIZE - 20, 0.5, -SIZE / 2)
    toggleBtn.BackgroundColor3 = CONFIG.Enabled and COLORS.On or COLORS.Off
    toggleBtn.Text = CONFIG.Enabled and "✓" or "✕"
    toggleBtn.TextColor3 = COLORS.Text
    toggleBtn.TextSize = 28
    toggleBtn.Font = Enum.Font.GothamBlack
    toggleBtn.AutoButtonColor = false
    toggleBtn.BorderSizePixel = 0
    toggleBtn.ZIndex = 10
    toggleBtn.Parent = gui
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(1, 0)

    local stk = Instance.new("UIStroke", toggleBtn)
    stk.Color = Color3.new(0, 0, 0); stk.Thickness = 2; stk.Transparency = 0.4

    -- Label ใต้ปุ่ม
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 60, 0, 14)
    lbl.Position = UDim2.new(0.5, -30, 1, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = "AUTO DODGE"
    lbl.TextColor3 = COLORS.TextDim
    lbl.TextSize = 9
    lbl.Font = Enum.Font.GothamBold
    lbl.ZIndex = 10
    lbl.Parent = toggleBtn

    -- ============ HUD ============
    hud = Instance.new("Frame")
    hud.Name = "LiveStatus"
    hud.Size = UDim2.fromOffset(210, 94)
    hud.Position = UDim2.new(1, -210 - 20, 0.5, SIZE / 2 + 8)
    hud.BackgroundColor3 = COLORS.HUD
    hud.BackgroundTransparency = 0.2
    hud.BorderSizePixel = 0
    hud.Visible = false
    hud.ZIndex = 8
    hud.Parent = gui
    Instance.new("UICorner", hud).CornerRadius = UDim.new(0, 6)

    -- ★ เก็บ reference ตรง ไม่พึ่ง GetChildren
    local function mkLine(y, txt, ref)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -12, 0, 14)
        l.Position = UDim2.fromOffset(6, y)
        l.BackgroundTransparency = 1
        l.Text = txt
        l.TextColor3 = COLORS.TextDim
        l.TextSize = 10
        l.Font = Enum.Font.Code
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.ZIndex = 9
        l.Parent = hud
        return l
    end
    hudState  = mkLine(4,  "state: OFF")
    hudPid    = mkLine(20, "pid: 0")
    hudNeeded = mkLine(36, "needed: nil")
    hudLand   = mkLine(52, "land: nil")
    hudFired  = mkLine(68, "fired: -")

    -- ============ PANEL ============
    panel = Instance.new("Frame")
    panel.Name = "SettingsPanel"
    panel.Size = UDim2.fromOffset(230, 210)
    panel.Position = UDim2.new(1, -230 - SIZE - 40, 0.5, -105)
    panel.BackgroundColor3 = COLORS.Panel
    panel.BorderSizePixel = 0
    panel.Visible = false
    panel.ZIndex = 9
    panel.Parent = gui
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)
    local pstk = Instance.new("UIStroke", panel)
    pstk.Color = Color3.fromRGB(60, 65, 85); pstk.Thickness = 1

    local function mkLabel(text, y, color)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -20, 0, 18)
        l.Position = UDim2.fromOffset(10, y)
        l.BackgroundTransparency = 1
        l.Text = text; l.TextColor3 = color or COLORS.Text
        l.TextSize = 13; l.Font = Enum.Font.GothamSemibold
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.ZIndex = 10
        l.Parent = panel
        return l
    end
    mkLabel("⚙ Auto Dodge", 8).TextSize = 14

    -- Enabled toggle
    enabledBtn = Instance.new("TextButton")
    enabledBtn.Size = UDim2.fromOffset(60, 20)
    enabledBtn.Position = UDim2.new(1, -70, 0, 38)
    enabledBtn.BackgroundColor3 = CONFIG.Enabled and COLORS.On or COLORS.Off
    enabledBtn.Text = CONFIG.Enabled and "ON" or "OFF"
    enabledBtn.TextColor3 = COLORS.Text; enabledBtn.TextSize = 11
    enabledBtn.Font = Enum.Font.GothamBold; enabledBtn.AutoButtonColor = false
    enabledBtn.BorderSizePixel = 0; enabledBtn.ZIndex = 10; enabledBtn.Parent = panel
    Instance.new("UICorner", enabledBtn).CornerRadius = UDim.new(0, 4)
    mkLabel("Enabled", 38)

    -- Margin
    marginLbl = Instance.new("TextLabel")
    marginLbl.Size = UDim2.fromOffset(60, 18)
    marginLbl.Position = UDim2.new(1, -70, 0, 66)
    marginLbl.BackgroundTransparency = 1
    marginLbl.Text = string.format("%.3f", CONFIG.Margin)
    marginLbl.TextColor3 = COLORS.Text; marginLbl.TextSize = 11
    marginLbl.Font = Enum.Font.Code; marginLbl.TextXAlignment = Enum.TextXAlignment.Right
    marginLbl.ZIndex = 10; marginLbl.Parent = panel
    mkLabel("Margin (s)", 66)

    -- Anti-Feint
    afBtn = Instance.new("TextButton")
    afBtn.Size = UDim2.fromOffset(60, 20)
    afBtn.Position = UDim2.new(1, -70, 0, 94)
    afBtn.BackgroundColor3 = CONFIG.AntiFeint and COLORS.On or COLORS.Off
    afBtn.Text = CONFIG.AntiFeint and "ON" or "OFF"
    afBtn.TextColor3 = COLORS.Text; afBtn.TextSize = 11
    afBtn.Font = Enum.Font.GothamBold; afBtn.AutoButtonColor = false
    afBtn.BorderSizePixel = 0; afBtn.ZIndex = 10; afBtn.Parent = panel
    Instance.new("UICorner", afBtn).CornerRadius = UDim.new(0, 4)
    mkLabel("Anti-Feint", 94)

    -- Live HUD toggle
    hudBtn = Instance.new("TextButton")
    hudBtn.Size = UDim2.fromOffset(60, 20)
    hudBtn.Position = UDim2.new(1, -70, 0, 122)
    hudBtn.BackgroundColor3 = COLORS.On
    hudBtn.Text = "SHOW"
    hudBtn.TextColor3 = COLORS.Text; hudBtn.TextSize = 10
    hudBtn.Font = Enum.Font.GothamBold; hudBtn.AutoButtonColor = false
    hudBtn.BorderSizePixel = 0; hudBtn.ZIndex = 10; hudBtn.Parent = panel
    Instance.new("UICorner", hudBtn).CornerRadius = UDim.new(0, 4)
    mkLabel("Live HUD", 122)

    -- Hint
    mkLabel("F1 = toggle | hold = settings", 168, COLORS.TextDim).TextSize = 10

    -- ============ INTERACTIONS ============
    refresh = function()
        if not toggleBtn or not toggleBtn.Parent then return end
        toggleBtn.BackgroundColor3 = CONFIG.Enabled and COLORS.On or COLORS.Off
        toggleBtn.Text = CONFIG.Enabled and "✓" or "✕"
        if enabledBtn and enabledBtn.Parent then
            enabledBtn.Text = CONFIG.Enabled and "ON" or "OFF"
            enabledBtn.BackgroundColor3 = CONFIG.Enabled and COLORS.On or COLORS.Off
        end
    end

    setEnabled = function(v)
        CONFIG.Enabled = v and true or false
        refresh()
        print("[AutoDodge]", CONFIG.Enabled and "✅ ON" or "❌ OFF")
    end

    openPanel = function()
        if panel then panel.Visible = true end
    end
    closePanel = function()
        if panel then panel.Visible = false end
    end

    enabledBtn.MouseButton1Click:Connect(function() setEnabled(not CONFIG.Enabled) end)
    afBtn.MouseButton1Click:Connect(function()
        CONFIG.AntiFeint = not CONFIG.AntiFeint
        afBtn.Text = CONFIG.AntiFeint and "ON" or "OFF"
        afBtn.BackgroundColor3 = CONFIG.AntiFeint and COLORS.On or COLORS.Off
    end)
    hudBtn.MouseButton1Click:Connect(function()
        hud.Visible = not hud.Visible
        hudBtn.Text = hud.Visible and "HIDE" or "SHOW"
    end)

    -- ============ LONG-PRESS FIX ============
    -- ★ State machine — ไม่มี double-toggle
    local STATE_IDLE      = 0
    local STATE_PRESSING  = 1
    local STATE_DRAGGING  = 2
    local STATE_LONGPRESS = 3

    local pstate      = STATE_IDLE
    local pressTick   = 0
    local pressPos    = Vector2.zero
    local dragOrigin  = UDim2.fromOffset(0, 0)
    local longTimer   = nil
    local longToken   = 0

    local function cancelLongTimer()
        longToken = longToken + 1
        if longTimer then
            task.cancel(longTimer)
            longTimer = nil
        end
    end

    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if pstate ~= STATE_IDLE then return end

        pstate     = STATE_PRESSING
        pressTick  = tick()
        pressPos   = Vector2.new(input.Position.X, input.Position.Y)
        dragOrigin = toggleBtn.Position

        -- ★ Token-safe long-press
        cancelLongTimer()
        local myToken = longToken
        longTimer = task.delay(0.55, function()
            longTimer = nil
            if myToken ~= longToken then return end
            if pstate == STATE_PRESSING then
                pstate = STATE_LONGPRESS
                if panel.Visible then
                    closePanel()
                else
                    openPanel()
                end
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if pstate ~= STATE_PRESSING and pstate ~= STATE_DRAGGING then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local cur = Vector2.new(input.Position.X, input.Position.Y)
        local d   = cur - pressPos
        if d.Magnitude > 8 then
            pstate = STATE_DRAGGING
            cancelLongTimer()    -- ★ ยกเลิก long-press ทันทีที่เริ่มลาก
            toggleBtn.Position = UDim2.fromOffset(
                dragOrigin.X.Offset + d.X,
                dragOrigin.Y.Offset + d.Y
            )
            -- panel + hud ตามปุ่ม
            panel.Position = UDim2.fromOffset(
                toggleBtn.Position.X.Offset - 260,
                toggleBtn.Position.Y.Offset - 105
            )
            hud.Position = UDim2.fromOffset(
                toggleBtn.Position.X.Offset - 230,
                toggleBtn.Position.Y.Offset + 34
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local prev = pstate
        pstate = STATE_IDLE
        cancelLongTimer()

        -- ★ Logic ถูก: toggle เฉพาะคลิกสั้นจริงๆ
        if prev == STATE_PRESSING then
            local dur = tick() - pressTick
            if dur < 0.5 then
                setEnabled(not CONFIG.Enabled)
            end
        end
        -- ถ้า STATE_LONGPRESS หรือ STATE_DRAGGING → ไม่ toggle (ถูกต้อง)
    end)

    -- ★ Hotkey F1 (fallback)
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.F1 then
            setEnabled(not CONFIG.Enabled)
        end
    end)

    -- ============ HUD UPDATER ============
    task.spawn(function()
        while gui and gui.Parent do
            task.wait(0.05)
            if hud and hud.Visible then
                local char = LP.Character
                hudState.Text = "state: " .. (CONFIG.Enabled and "ON" or "OFF")
                local pid = 0
                if opponent then
                    pid = opponent:GetAttribute("CurrentPunchId") or 0
                end
                hudPid.Text = "pid: " .. tostring(pid)
                local nd = "nil"
                if char then
                    local n = char:GetAttribute("NeededDirection")
                    if n then nd = tostring(n) end
                end
                hudNeeded.Text = "needed: " .. nd
                if opponent then
                    local lt = opponent:GetAttribute("LandTime")
                    if lt then
                        hudLand.Text = string.format("land: %.3fs", lt - Workspace:GetServerTimeNow())
                    else
                        hudLand.Text = "land: nil"
                    end
                else
                    hudLand.Text = "land: -"
                end
                hudFired.Text = "fired: " ..
                    (lastFireTick and lastFireTick > 0
                        and string.format("%.2f", tick() - lastFireTick) or "-")
            end
        end
    end)

    refresh()
end

-- สร้าง GUI ครั้งแรก
buildGUI()

-- ★ AUTO-RECOVER: ถ้า GUI หาย → สร้างใหม่ทันที
task.spawn(function()
    while true do
        task.wait(1)
        if not gui or not gui.Parent then
            print("[AutoDodge] GUI หาย → สร้างใหม่")
            buildGUI()
        end
    end
end)
