local tabStatus = Window:CreateTab("Status", 4483362458)

local statusCatch = tabStatus:CreateParagraph({Title="AutoCatch",Content="-"})
local statusBag   = tabStatus:CreateParagraph({Title="Bag",Content="-"})
local statusShip  = tabStatus:CreateParagraph({Title="Ship",Content="-"})
local statusCodes = tabStatus:CreateParagraph({Title="Codes",Content="-"})

task.spawn(function()
    while true do
        task.wait(0.5)
        local cReady,cReason = catchPlayerReady()
        pcall(function()
            statusCatch:Set({Title="AutoCatch",Content=string.format(
                "%s\n%s\nReason: %s\nThrown:%d Blocked:%d Fail:%d",
                catchState.running and "🟢 RUNNING" or "🔴 STOPPED",
                cReady and "✅ Ready" or ("⏸ "..tostring(cReason)),
                stats.lastReason, stats.caught, stats.blocked, stats.failed)})
        end)
        local b = readBag()
        local bl = {}
        for _,t in TierOrder do table.insert(bl, string.format("  • %-8s : %d", t, b[t] or 0)) end
        pcall(function() statusBag:Set({Title="Bag",Content=table.concat(bl,"\n")}) end)
        local sh = shipState.ship
        pcall(function()
            statusShip:Set({Title="Ship",Content=string.format(
                "%s | Method: %s | x%.2f",
                sh and sh.Name or "—", shipState.method,
                shipState.enabled and shipState.multiplier or 1)})
        end)
        pcall(function()
            statusCodes:Set({Title="Codes",Content=string.format(
                "Tried: %d  OK: %d\nRemote: %s",
                stats.codesTried, stats.codesOK,
                (codeState.remote and codeState.remote.Name) or "ยังไม่พบ")})
        end)
    end
end)

