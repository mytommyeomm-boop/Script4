local CONFIG = {
    Enabled             = false,     -- เริ่มที่ OFF
    Margin              = 0.02,
    MinCooldown         = 0.06,
    StrictSide          = true,
    OnlyWhenTargeted    = true,
    AntiFeint           = true,
    LatencyCompensation = true,
    ManualPingOffset    = nil,
    Debug               = false,
}

local lastDodgeTime = 0
local opponent      = nil
local conns         = {}
local alternateSide = "Left"
local activePunch   = {
    id = 0, startTime = 0, hitTime = 0,
    cancelled = false, dashed = false,
    isHeavy = false, startup = 0.2,
}

local function log(...)
    if CONFIG.Debug then print("[Dodge]", ...) end
end

local function getState(n)
    local s = Workspace:FindFirstChild("States")
    return s and s:FindFirstChild(n)
end
local function getMyCD()  local s = getState(LP.Name); return s and s:FindFirstChild("CharacterData") end
local function getMyOcc() local s = getState(LP.Name); return s and s:FindFirstChild("Occupied") end

local function canDash()
    local c = LP.Character
    if not (c and c.PrimaryPart) then return false end
    local o = getMyOcc(); if not o then return false end
    if o.Dashing.Value then return false end
    local d = getMyCD(); if not d then return false end
    if d.Stunned.Value or d.Cutscene.Value then return false end
    if d.Stamina.Value <= 1 then return false end
    if c:GetAttribute("RiceballChanneling") then return false end
    if c:GetAttribute("NoDash") then return false end
    return true
end

local function getNeededDirection()
    local c = LP.Character; if not c then return nil end
    local dir = c:GetAttribute("NeededDirection")
    if dir == "Left" or dir == "Right" or dir == "Forward" or dir == "Backward" then
        return dir
    end
    return nil
end

local function computeSideDirection()
    local c = LP.Character
    if not (c and c.PrimaryPart) then return alternateSide end
    local o = getMyOcc()
    local locked = o and o.LockedOn.Value
    if locked and locked.PrimaryPart then
        local away = (c.PrimaryPart.Position - locked.PrimaryPart.Position) * Vector3.new(1,0,1)
        if away.Magnitude > 0.1 then
            away = away.Unit
            local side = Vector3.new(away.Z, 0, -away.X)
            local look = c.PrimaryPart.CFrame.LookVector * Vector3.new(1,0,1)
            if look.Magnitude > 0.1 then
                return side:Dot(look.Unit) > 0 and "Right" or "Left"
            end
        end
    end
    return alternateSide
end

local function isOppFeinting(opp)
    if not opp then return false end
    return opp:GetAttribute("IsFeinting") == true
        or opp:GetAttribute("LocalIsFeinting") == true
end

local function isOppPunching(opp)
    if not opp then return false end
    if opp:GetAttribute("Punching") == true then return true end
    if opp:GetAttribute("IsHeavy") == true then return true end
    local os = getState(opp.Name)
    local occ = os and os:FindFirstChild("Occupied")
    local p = occ and occ:FindFirstChild("Punching")
    return p and p.Value or false
end

local function getStartup(opp, heavy)
    local os = getState(opp.Name); if not os then return 0.2 end
    local pd = os:FindFirstChild("PlayerData")
    local occ = os:FindFirstChild("Occupied")
    if not (pd and occ) then return 0.2 end
    local sv = pd:FindFirstChild("Style"); if not sv then return 0.2 end
    local style = Styles[sv.Value]; if not style then return 0.2 end
    local info
    if heavy then
        info = style.HeavyAttacks and style.HeavyAttacks.DefaultPunchInfo
    else
        local cid = 1
        local cc = occ:FindFirstChild("CurrentCombo")
        if cc then cid = cc.Value end
        local combo = style.Combos[cid]
        info = combo and combo.DefaultPunchInfo
    end
    if not info then info = style.DefaultPunchInfo end
    return (info and info.Startup) or 0.2
end

local function doDodge(dir)
    if not canDash() then return false end
    local now = Workspace:GetServerTimeNow()
    if now - lastDodgeTime < CONFIG.MinCooldown then return false end
    lastDodgeTime = now
    if dir == "Left" then alternateSide = "Right"
    elseif dir == "Right" then alternateSide = "Left" end
    ForceDash:Fire({ Direction = dir, IgnoreStun = false })
    log("DASH →", dir)
    return true
end

local function getPingOffset()
    if CONFIG.ManualPingOffset then return CONFIG.ManualPingOffset end
    if not CONFIG.LatencyCompensation then return 0 end
    local ping = LP:GetNetworkPing() or 0
    return math.clamp(ping / 2, 0.02, 0.10)
end

RunService.Heartbeat:Connect(function()
    if not CONFIG.Enabled then return end
    if not opponent then return end
    if activePunch.dashed or activePunch.cancelled then return end
    if not canDash() then return end

    if CONFIG.AntiFeint and isOppFeinting(opponent) then
        activePunch.cancelled = true
        log("FEINT → cancel")
        return
    end

    local dir = getNeededDirection()
    if not dir then return end

    local char = LP.Character
    if char and char:GetAttribute("Perfect") then
        if doDodge(dir) then
            activePunch.dashed = true
            log("PERFECT ✓ via flag")
        end
        return
    end

    local landTime = opponent:GetAttribute("LandTime")
    if not landTime then return end
    local now      = Workspace:GetServerTimeNow()
    local offset   = getPingOffset()
    local timeLeft = landTime - now

    if timeLeft <= (offset + CONFIG.Margin) and timeLeft >= -0.06 then
        local d = dir
        if CONFIG.StrictSide and (d == "Forward" or d == "Backward") then
            d = computeSideDirection()
        end
        if doDodge(d) then
            activePunch.dashed = true
            log(("PERFECT ✓ LandTime (t=%.3f)"):format(timeLeft))
        end
    end
end)

local function onPunch(opp, forceHeavy)
    if not CONFIG.Enabled then return end
    if not activePunch.cancelled and not activePunch.dashed then
        activePunch.cancelled = true
    end
    if CONFIG.OnlyWhenTargeted then
        local os  = getState(opp.Name)
        local occ = os and os:FindFirstChild("Occupied")
        local tgt = occ and occ:FindFirstChild("LockedOn")
        if tgt and tgt.Value ~= LP.Character then return end
    end
    local heavy = forceHeavy
    if heavy == nil then heavy = opp:GetAttribute("IsHeavy") == true end
    local startup = getStartup(opp, heavy)
    local now = Workspace:GetServerTimeNow()
    local token = {
        id = opp:GetAttribute("CurrentPunchId") or 0,
        startTime = now, hitTime = now + startup,
        startup = startup, isHeavy = heavy,
        cancelled = false, dashed = false,
    }
    activePunch = token
    task.delay(math.max(0, startup - CONFIG.Margin), function()
        if activePunch ~= token then return end
        if token.cancelled or token.dashed then return end
        if not CONFIG.Enabled then return end
        if CONFIG.AntiFeint and isOppFeinting(opp) then
            token.cancelled = true; return
        end
        local el = Workspace:GetServerTimeNow() - token.startTime
        if CONFIG.AntiFeint and not isOppPunching(opp) and el < token.startup * 0.85 then
            token.cancelled = true; return
        end
        local dir = getNeededDirection() or computeSideDirection()
        if CONFIG.StrictSide and (dir == "Forward" or dir == "Backward") then
            dir = computeSideDirection()
        end
        if doDodge(dir) then token.dashed = true end
    end)
end

local function unbind()
    for _, c in ipairs(conns) do c:Disconnect() end
    table.clear(conns)
    opponent = nil
end

local function bind(oppChar)
    unbind()
    if not oppChar then return end
    opponent = oppChar
    log("bound:", oppChar.Name)
    local lastId = oppChar:GetAttribute("CurrentPunchId") or 0
    table.insert(conns, oppChar:GetAttributeChangedSignal("CurrentPunchId"):Connect(function()
        local nid = oppChar:GetAttribute("CurrentPunchId") or 0
        if nid ~= lastId then
            lastId = nid
            onPunch(oppChar, nil)
        end
    end))
    local os = getState(oppChar.Name)
    local occ = os and os:FindFirstChild("Occupied")
    local punching = occ and occ:FindFirstChild("Punching")
    if punching then
        local prev = punching.Value
        table.insert(conns, punching.Changed:Connect(function(v)
            if v and not prev then onPunch(oppChar, nil) end
            prev = v
        end))
    end
    local wp = oppChar:GetAttribute("Punching") or false
    table.insert(conns, oppChar:GetAttributeChangedSignal("Punching"):Connect(function()
        local n = oppChar:GetAttribute("Punching") or false
        if n and not wp then onPunch(oppChar, nil) end
        wp = n
    end))
    local wh = oppChar:GetAttribute("HeavyPunching") or false
    table.insert(conns, oppChar:GetAttributeChangedSignal("HeavyPunching"):Connect(function()
        local n = oppChar:GetAttribute("HeavyPunching") or false
        if n and not wh then onPunch(oppChar, true) end
        wh = n
    end))
    local wf = oppChar:GetAttribute("IsFeinting") or false
    table.insert(conns, oppChar:GetAttributeChangedSignal("IsFeinting"):Connect(function()
        local n = oppChar:GetAttribute("IsFeinting") or false
        if n and not wf and CONFIG.AntiFeint then
            activePunch.cancelled = true
        end
        wf = n
    end))
end

local function watchOpponent()
    local cd = getMyCD(); if not cd then return end
    local oppVal = cd:FindFirstChild("Opponent"); if not oppVal then return end
    bind(oppVal.Value)
    table.insert(conns, oppVal.Changed:Connect(bind))
end

task.spawn(function()
    while not getMyCD() do task.wait(0.2) end
    watchOpponent()
end)
LP.CharacterAdded:Connect(function()
    task.wait(1)
    watchOpponent()
end)

