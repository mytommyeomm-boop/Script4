-- หา redeem remote
local function findRedeemRemote()
    if codeState.remote then return codeState.remote end
    if not RemotesFolder then return nil end
    local names = {
        "RedeemAct","RedeemQuery","CodeAct","CodeRedeem","RedeemCode",
        Net.SettingsAct,
        (type(Net.RedeemAct)=="string" and Net.RedeemAct or nil),
    }
    for _,n in names do
        if type(n)=="string" then
            local r = RemotesFolder:FindFirstChild(n)
            if r and (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then
                codeState.remote = r; return r
            end
        end
    end
    for _,r in RemotesFolder:GetChildren() do
        if not (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then continue end
        local l = string.lower(r.Name)
        if string.find(l,"redeem") or string.find(l,"code") or string.find(l,"gift") then
            codeState.remote = r; return r
        end
    end
    return nil
end

-- สแกนหา code ในแมพ
local function scanMapCodes()
    local found, seen = {}, {}
    local function add(c)
        if type(c)=="string" and #c>=3 and #c<=40 and not seen[c] then
            seen[c]=true; table.insert(found,c)
        end
    end
    local function scan(root)
        if not root then return end
        for _,o in root:GetDescendants() do
            if o:IsA("StringValue") and o.Value~="" then
                local n = string.lower(o.Name)
                if string.find(n,"code") or string.find(n,"redeem") then add(o.Value) end
            elseif o:IsA("BasePart") and o:GetAttribute("IsCode")==true then
                add(o:GetAttribute("Code") or o.Name)
            elseif o:IsA("TextLabel") and o:GetAttribute("IsCode")==true then
                add(o.Text)
            elseif o:IsA("Model") and o:GetAttribute("IsCode")==true then
                add(o:GetAttribute("Code") or o.Name)
            end
        end
    end
    scan(Workspace)
    scan(ReplicatedStorage)
    return found
end

-- redeem 1 code (ลองหลาย payload)
local function redeemCode(code)
    local r = findRedeemRemote()
    if not r then return false,"ไม่พบ remote" end
    local payloads = {
        {code=code},
        {Code=code},
        {codeText=code},
        {kind="code",code=code},
        {Action="code",code=code},
        {action="redeem",code=code},
        {code=code,quiet=true},
    }
    for _,p in payloads do
        local ok,res
        if r:IsA("RemoteFunction") then
            ok,res = pcall(function() return r:InvokeServer(p) end)
        else
            ok,res = pcall(function() r:FireServer(p) end)
            if ok then res = "sent" end
        end
        if ok and res~=nil then
            local success = false
            if type(res)=="boolean" then success=res
            elseif type(res)=="table" then success = res.ok==true or res.success==true
            elseif type(res)=="string" then success = res~="" and res~="false" end
            if success then
                return true, tostring(res)
            end
        end
    end
    return false,"ล้มเหลว"
end

-- batch redeem
local function redeemBatch(list, progressCb)
    codeState.results = {}
    for i,code in list do
        -- cooldown
        local wait = codeState.cooldown - (os.clock() - codeState.lastFire)
        if wait > 0 then task.wait(wait) end
        codeState.lastFire = os.clock()
        stats.codesTried += 1
        local ok,resp = redeemCode(code)
        if ok then stats.codesOK += 1 end
        table.insert(codeState.results, {code=code, ok=ok, resp=resp})
        if progressCb then progressCb(i,#list,code,ok,resp) end
    end
end

