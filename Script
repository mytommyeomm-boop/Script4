local sDodge = mkLabel(panel, "Dodges: 0",   342)
local sPerf  = mkLabel(panel, "Perfect: 0",  362, Color3.fromRGB(255, 215, 80))
local sInt   = mkLabel(panel, "Intercepts: 0", 382, COLORS.Intercept)
local sQueued= mkLabel(panel, "Queued: -",   402, COLORS.TextDim, 11)

RunService.Heartbeat:Connect(function()
    if not panel.Visible then return end
    sDodge.Text = "Dodges: " .. stats.dodges
    sPerf.Text  = "Perfect: " .. stats.perfects
    sInt.Text   = "Intercepts: " .. stats.intercepts
    local now = Workspace:GetServerTimeNow()
    if now < feint.armedUntil then
        local left = feint.armedUntil - now
        sQueued.Text = string.format("🎯 ARMED %.2fs", left)
        sQueued.TextColor3 = COLORS.Intercept
    elseif pendingDodge then
        local left = math.max(0, pendingDodge.expires - now)
        sQueued.Text = string.format("Queued: %.2fs", left)
        sQueued.TextColor3 = Color3.fromRGB(255, 180, 80)
    else
        sQueued.Text = "Queued: -"
        sQueued.TextColor3 = COLORS.TextDim
    end
end)

-- ============ INTERACTIONS ============
local function refreshToggle()
    toggle.BackgroundColor3 = CFG.Enabled and COLORS.On or COLORS.Off
    toggle.Text = CFG.Enabled and "✓" or "✕"
    TS:Create(toggle, TweenInfo.new(0.15, Enum.EasingStyle.Back),
        { Size = UDim2.fromOffset(TSIZE, TSIZE) }):Play()
end

local function setEnabled(v)
    CFG.Enabled = v and true or false
    if not CFG.Enabled then pendingDodge = nil end
    refreshToggle()
    print("[AutoDodge]", CFG.Enabled and "✅ ON" or "❌ OFF")
end

-- === ปุ่ม toggle: click = toggle ล้วน (ไม่มีการกดค้าง) ===
toggle.MouseButton1Click:Connect(function()
    setEnabled(not CFG.Enabled)
end)

-- === ปุ่ม gear: click = เปิด/ปิด panel ===
gear.MouseButton1Click:Connect(function()
    panel.Visible = not panel.Visible
    gear.BackgroundColor3 = panel.Visible and COLORS.GearHi or COLORS.Gear
end)

-- === ลาก toggle ได้ (panel ขยับตาม) ===
local drag = { active = false, moved = false, start = Vector2.zero, pos0 = nil, wasEnabled = false }
toggle.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        drag.active = true
        drag.moved = false
        drag.start = Vector2.new(i.Position.X, i.Position.Y)
        drag.pos0 = toggle.Position
        drag.wasEnabled = CFG.Enabled
    end
end)
UIS.InputChanged:Connect(function(i)
    if drag.active and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
        local cur = Vector2.new(i.Position.X, i.Position.Y)
        local d = cur - drag.start
        if d.Magnitude > 6 then
            drag.moved = true
            toggle.Position = UDim2.fromOffset(drag.pos0.X.Offset + d.X, drag.pos0.Y.Offset + d.Y)
            gear.Position = UDim2.new(1, -GSIZE - 20, 0.5, -TSIZE / 2 + TSIZE + 6)
            gear.Position = UDim2.fromOffset(
                toggle.Position.X.Offset + (TSIZE - GSIZE) / 2,
                toggle.Position.Y.Offset + TSIZE + 6
            )
            panel.Position = UDim2.fromOffset(
                toggle.Position.X.Offset - 250,
                toggle.Position.Y.Offset - 220
            )
        end
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        drag.active = false
    end
end)

