-- หาเรือของผู้เล่น
local function findOwnShip()
    for _,m in Workspace:GetChildren() do
        if m:IsA("Model")
           and m:GetAttribute("PlayerShip")==true
           and m:GetAttribute("ShipOwner")==LocalPlayer.UserId then
            return m
        end
    end
    return nil
end

-- หา remote ที่น่าจะเป็น ShipControls
local function findShipRemote()
    if shipState.shipRemote then return shipState.shipRemote end
    if not RemotesFolder then return nil end
    local names = {"ShipControls","ShipAct","ShipHelm","ShipMove","ShipInput","HelmAct","SteerAct"}
    for _,n in names do
        local r = RemotesFolder:FindFirstChild(n)
        if r and (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then
            shipState.shipRemote = r; return r
        end
    end
    -- scan
    for _,r in RemotesFolder:GetChildren() do
        if not (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then continue end
        local l = string.lower(r.Name)
        if string.find(l,"ship") or string.find(l,"helm") or string.find(l,"steer") then
            shipState.shipRemote = r; return r
        end
    end
    return nil
end

-- Method 1: BodyVelocity (visual boost)
local function applyBodyVelocity(ship)
    local pp = ship.PrimaryPart or ship:FindFirstChildWhichIsA("BasePart",true)
    if not pp then return end
    local bv = shipState.bv
    if not bv or bv.Parent ~= pp then
        if bv then bv:Destroy() end
        bv = Instance.new("BodyVelocity")
        bv.Name = "_SpeedHack"
        bv.MaxForce = Vector3.new(math.huge,0,math.huge)
        bv.Parent = pp
        shipState.bv = bv
    end
    local speed = ship:GetAttribute("ShipSpeed") or 0
    if math.abs(speed) < 0.1 then
        bv.Velocity = Vector3.zero
        return
    end
    -- ทิศทาง: ship heading ใช้ sin/cos, เทียบได้กับ LookVector (Y=0)
    local look = pp.CFrame.LookVector
    local flat = Vector3.new(look.X,0,look.Z)
    if flat.Magnitude < 0.001 then flat = Vector3.new(0,0,-1) end
    flat = flat.Unit
    bv.Velocity = flat * speed * (shipState.multiplier - 1)
end

-- Method 2: Attribute (ลองเขียน attribute)
local function applyAttribute(ship)
    -- ShipSpeed เป็น server-set, แต่ลอง mult attributes อื่น
    pcall(function()
        ship:SetAttribute("ShipSpeedMultiplier", shipState.multiplier)
        ship:SetAttribute("_ClientSpeedMult", shipState.multiplier)
        ship:SetAttribute("SpeedBoost", shipState.multiplier)
    end)
end

-- Method 3: CFrame Pivot (visual ล้วน)
local function applyCFrame(ship,dt)
    local speed = ship:GetAttribute("ShipSpeed") or 0
    if math.abs(speed) < 0.1 then return end
    local pv = ship:GetPivot()
    local look = pv.LookVector
    local flat = Vector3.new(look.X,0,look.Z)
    if flat.Magnitude < 0.001 then return end
    flat = flat.Unit
    local boost = speed * (shipState.multiplier - 1) * dt
    ship:PivotTo(pv + flat * boost)
end

-- Method 4: Input Spam (ยิง helm remote ถี่)
local function applyInputSpam(ship,now)
    if now - shipState.lastSpam < 0.05 then return end
    shipState.lastSpam = now
    local r = findShipRemote()
    if not r then return end
    local level = ship:GetAttribute("ShipLevel") or 1
    local maxSpeed = PlayerShip.SpeedStudsPerSecond[level] or 30
    -- พยายามส่ง helm แบบเต็มกำลัง
    local payloads = {
        {helm={throttle=1,steer=0}},
        {throttle=1,steer=0},
        {input={throttle=1,steer=0}},
        {x=0,z=1},
    }
    for _,p in payloads do
        pcall(function()
            if r:IsA("RemoteEvent") then r:FireServer(p) else r:InvokeServer(p) end
        end)
    end
end

