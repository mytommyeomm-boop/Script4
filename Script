-- long-press = open settings | short click = toggle
local pressStart = 0
local pressPos   = Vector2.zero
local moved      = false
local longPressed = false
local dragStart  = nil
local dragPos0   = nil

toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        pressStart = tick()
        pressPos = Vector2.new(input.Position.X, input.Position.Y)
        moved = false
        longPressed = false
        dragStart = pressPos
        dragPos0 = toggleBtn.Position
        -- start long-press timer
        task.delay(0.55, function()
            if not moved and not longPressed
                and (input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch) then
                longPressed = true
                -- toggle settings panel
                if panel.Visible then
                    panel.Visible = false
                    TweenService:Create(panel, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
                else
                    panel.Visible = true
                    panel.BackgroundTransparency = 0
                    for _, d in panel:GetDescendants() do
                        if d:IsA("TextLabel") or d:IsA("TextButton") then
                            d.TextTransparency = 0
                        end
                    end
                end
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local cur = Vector2.new(input.Position.X, input.Position.Y)
        local delta = cur - dragStart
        if delta.Magnitude > 8 then
            moved = true
            toggleBtn.Position = UDim2.fromOffset(
                dragPos0.X.Offset + delta.X,
                dragPos0.Y.Offset + delta.Y
            )
            panel.Position = UDim2.fromOffset(
                toggleBtn.Position.X.Offset - 240,
                toggleBtn.Position.Y.Offset - 120
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if dragStart then
            local dur = tick() - pressStart
            dragStart = nil
            if not moved and not longPressed and dur < 0.5 then
                -- short click → toggle
                setEnabled(not CONFIG.Enabled)
            end
        end
    end
end)

