local function mkLabel(parent, text, y, color, size)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -20, 0, 18)
    l.Position = UDim2.fromOffset(10, y)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or COLORS.Text
    l.TextSize = size or 13
    l.Font = Enum.Font.GothamSemibold
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.ZIndex = 10
    l.Parent = parent
    return l
end

local function mkToggle(parent, text, y, key, cb)
    mkLabel(parent, text, y)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(70, 22)
    btn.Position = UDim2.new(1, -80, 0, y)
    btn.BackgroundColor3 = CFG[key] and COLORS.On or COLORS.Off
    btn.Text = CFG[key] and "ON" or "OFF"
    btn.TextColor3 = COLORS.Text
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.ZIndex = 10
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    btn.MouseButton1Click:Connect(function()
        CFG[key] = not CFG[key]
        btn.Text = CFG[key] and "ON" or "OFF"
        btn.BackgroundColor3 = CFG[key] and COLORS.On or COLORS.Off
        if cb then cb(CFG[key]) end
    end)
    return btn
end

local function mkSlider(parent, text, y, min, max, initial, cb)
    mkLabel(parent, text, y)
    local val = Instance.new("TextLabel")
    val.Size = UDim2.fromOffset(80, 18)
    val.Position = UDim2.new(1, -90, 0, y)
    val.BackgroundTransparency = 1
    val.Text = string.format("%.2f", initial)
    val.TextColor3 = COLORS.Text
    val.TextSize = 12
    val.Font = Enum.Font.GothamBold
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.ZIndex = 10
    val.Parent = parent

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.fromOffset(10, y + 20)
    bar.BackgroundColor3 = COLORS.SliderBg
    bar.BorderSizePixel = 0
    bar.ZIndex = 10
    bar.Parent = parent
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((initial - min) / (max - min), 1)
    fill.BackgroundColor3 = COLORS.Slider
    fill.BorderSizePixel = 0
    fill.ZIndex = 10
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function setX(x)
        local ax = bar.AbsolutePosition.X
        local w  = bar.AbsoluteSize.X
        if w <= 0 then return end
        local p = math.clamp((x - ax) / w, 0, 1)
        local v = min + (max - min) * p
        fill.Size = UDim2.fromScale(p, 1)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        val.Text = string.format("%.2f", v)
        cb(v)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; setX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            setX(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return val
end

